{
  "name": "neethome-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-provenance.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@tanstack/react-query": "^5.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.38.0",
    "wagmi": "^2.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "playwright": "^1.64.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
